rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile: Private to the authenticated user
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Stores & Menus: Publicly readable catalog
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Orders: Accessible by the order creator
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow delete: if false;
    }

    // Test connection doc check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
